rules_version = '2';

// Cutoff model: a mealDays field may only change value (from what it currently
// is, defaulting to false/0 if the doc doesn't exist yet) before that field's
// slot cutoff. Noon cutoff = 03:00 UTC on `date` (09:00 Dhaka). Night cutoff =
// 12:00 UTC on `date` (18:00 Dhaka). Bangladesh has no DST, so this fixed UTC
// offset is safe. Unchanged-value writes are always allowed regardless of time.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isManager == true;
    }

    function guestInRange(n) {
      return n is int && n >= 0 && n <= 5;
    }

    function dateAtUtc(date) {
      let parts = date.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    function slotOf(field) {
      return (field == 'noon' || field == 'noonGuests') ? 'noon' : 'night';
    }

    function beforeCutoff(date, slot) {
      return request.time < dateAtUtc(date) + duration.value(slot == 'noon' ? 3 : 12, 'h');
    }

    function isGuestField(field) {
      return field == 'noonGuests' || field == 'nightGuests';
    }

    function priorBoolValue(field) {
      return resource != null ? resource.data[field] : false;
    }

    function priorGuestValue(field) {
      return resource != null ? resource.data[field] : 0;
    }

    function fieldUnchanged(field) {
      return isGuestField(field)
        ? request.resource.data[field] == priorGuestValue(field)
        : request.resource.data[field] == priorBoolValue(field);
    }

    // `date` is the path segment (the day-wise doc this entry lives under),
    // never the client-supplied field — a client can't lie about which day's
    // cutoff applies by mismatching the two.
    function fieldOk(field, date) {
      return fieldUnchanged(field)
        || beforeCutoff(date, slotOf(field));
    }

    match /users/{uid} {
      // Full profile readable by any signed-in member (small, trusted mess).
      allow read: if isSignedIn();
      // Self-service bootstrap on first login: a member can create their OWN
      // profile doc, always starting as a non-manager. isManager can only be
      // granted afterward by an admin via console/admin SDK — never by the
      // member themselves, at creation or via the update rule below.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.isManager == false
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is number
        && request.resource.data.locale in ['en', 'bn'];
      // The one self-service update exception: a member may update their own
      // `locale` preference — and nothing else, so isManager can't be
      // self-escalated through this door either.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locale'])
        && request.resource.data.locale in ['en', 'bn'];
      allow delete: if false;
    }

    // collectionGroup('entries') reads (own-history + month-to-date queries
    // span every date, not one known parent) only pick up permission from a
    // rule expressed with the recursive wildcard — a rule nested under a
    // fixed parent path does not extend to collection-group-scoped queries.
    match /{path=**}/entries/{uid} {
      allow read: if isSignedIn();
    }

    // Day-wise: one doc per date, holding one entry per member (+ their guests).
    match /mealDays/{date}/entries/{uid} {
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.date == date
        && guestInRange(request.resource.data.noonGuests)
        && guestInRange(request.resource.data.nightGuests)
        && fieldOk('noon', date) && fieldOk('night', date)
        && fieldOk('noonGuests', date) && fieldOk('nightGuests', date);

      // Always write false/0 explicitly instead of deleting — keeps the cutoff
      // check above as the single source of truth for editability.
      allow delete: if false;
    }

    match /messCancellations/{date} {
      allow read: if isSignedIn();
      // Manager cancellations bypass the cutoff entirely (emergency override).
      allow create, update: if isManager()
        && request.resource.data.date == date
        && request.resource.data.setBy == request.auth.uid;
      allow delete: if isManager();
    }
  }
}
